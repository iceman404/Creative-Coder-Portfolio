# Apache .htaccess for Clean URLs
# Removes .html extension from URLs for better SEO

# Enable Rewrite Engine
RewriteEngine On

# Error Handling - Custom 404 page
ErrorDocument 404 /404.html

# Force HTTPS and Redirect Non-WWW to WWW
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^iceman404\.com [NC]
RewriteRule ^(.*)$ https://www.iceman404.com/$1 [L,R=301]

# Redirect .html URLs to clean URLs (301 Permanent Redirect)
# This ensures /bio.html redirects to /bio
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.html [NC]
RewriteRule ^([^.]+)\.html$ /$1 [R=301,L]

# Redirect index.html to root
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Internal rewrite: Add .html extension for clean URLs
# Only if the requested file doesn't exist and is not a directory
# Exclude static assets and API endpoints
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/404
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !\.(css|js|png|jpg|jpeg|gif|svg|avif|webp|ico|pdf|mp3|mp4|woff|woff2|ttf|eot|json|xml|txt)$ [NC]
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# Handle root URL - serve index.html
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^$ index.html [L]

# Enable Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/xml application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Enable Browser Caching for Static Files
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/xml "access plus 1 month"
  ExpiresByType application/json "access plus 1 month"
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  # Prevent clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"
  # XSS Protection
  Header always set X-XSS-Protection "1; mode=block"
  # Content Type Options
  Header always set X-Content-Type-Options "nosniff"
  # Referrer Policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Prevent access to hidden files
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>
